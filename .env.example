# Copie a .env: único punto editable de configuración de las conexiones.
GUAGUA_APP_ENV=local
GUAGUA_DB_HOST=localhost
GUAGUA_DB_PORT=7000
GUAGUA_DB_USER=root
GUAGUA_DB_PASSWORD=""
GUAGUA_DB_NAME=guagua
GUAGUA_DB_EDUTASK_NAME=edutask_db
GUAGUA_DB_PROMPT_NAME=prompt
GUAGUA_DB_MOODLE_NAME=moodle
GUAGUA_DB_CHARSET=utf8mb4
GUAGUA_TIMEZONE=America/Bogota
GUAGUA_DB_TIME_ZONE=-05:00
GUAGUA_DB_TIMEOUT=5
# Opcional: sustituye la ruta guardada en la configuración de asistencia.
GUAGUA_ATTENDANCE_FILE=""

# Recuperación de acceso: genere una clave aleatoria privada de al menos 32 caracteres.
GUAGUA_RESET_SECRET=""
GUAGUA_PUBLIC_URL=http://localhost/guagua
GUAGUA_MAIL_FROM=noreply@example.com

# Google Calendar: cliente OAuth de tipo Aplicación web (identificador público).
GUAGUA_GOOGLE_CLIENT_ID=""
# Acceso persistente de Google Health. El secreto nunca se envía al navegador.
GUAGUA_GOOGLE_CLIENT_SECRET=""
# Clave privada de 64 caracteres hexadecimales para cifrar autorizaciones guardadas.
GUAGUA_HEALTH_TOKEN_KEY=""

# Para producción use GUAGUA_APP_ENV=production y configure GUAGUA_DB_*.

# Perfil separado de importación a hosting: hosting
GUAGUA_DB_HOSTING_HOST=database-host
GUAGUA_DB_HOSTING_PORT=3306
GUAGUA_DB_HOSTING_USER=database-user
GUAGUA_DB_HOSTING_PASSWORD=change-me
GUAGUA_DB_HOSTING_NAME=guagua
