{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISA — English Tutor",
  "version": "0.1.0",
  "identifier": "com.isa.english-tutor",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir .. build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ISA — English Tutor",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1 http://127.0.0.1:1420 http://127.0.0.1:11434 http://169.254.173.61:1234; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
